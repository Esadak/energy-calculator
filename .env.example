# ─────────────────────────────────────────
# Energy Calculator - Environment Variables
# ─────────────────────────────────────────

# Databas (Neon PostgreSQL i produktion, lokal under utveckling)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/energy_calc_dev"

# Google Gemini AI - API key för energirekommendationer
# Hämta nyckel på: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# App URL - används för metadata och delning
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin-lösenord (ändra i produktion!)
ADMIN_PASSWORD="change-this-in-production"