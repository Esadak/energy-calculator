generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Calculation {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now()) @map("created_at")
  
  // FIX: Lägg till @default(now()) här så gamla rader får ett värde
  updatedAt   DateTime @updatedAt @default(now()) @map("updated_at")

  userId      String?
  userEmail   String?  @map("user_email")
  housingType String   @map("housing_type")
  heatingType String   @map("heating_type")
  postalCode  String   @map("postal_code")
  monthlyCost Decimal  @map("monthly_cost") @db.Decimal(10, 2)
  aiReport    String?  @map("ai_report")
  isPremium   Boolean  @default(false) @map("is_premium")
  
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("calculations")
}

model AffiliateClick {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now()) @map("created_at")
  category      String
  calculationId String?  @map("calculation_id")
  ipAddress     String?  @map("ip_address")

  @@map("affiliate_clicks")
}

// ============================================
// NYA MODELLER FÖR NEXTAUTH (lägg till dessa)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?   // Hashed password
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  calculations  Calculation[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}